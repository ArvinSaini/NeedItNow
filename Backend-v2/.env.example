# Server
PORT=5000
NODE_ENV=development

# MongoDB connection string. Use "npm run dev:memory" to run without one.
MONGODB_URI=mongodb://127.0.0.1:27017/needitnow

# Auth. JWT_SECRET must be at least 16 characters; use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS=

# Comma-separated browser origins allowed by CORS. Empty allows all (dev only).
CORS_ORIGINS=http://localhost:5173
